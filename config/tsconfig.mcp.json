{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["../scripts/**/*.ts", "../backend/lib/*.ts", "../tests/**/*.ts"]
}
