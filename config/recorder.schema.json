{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://money-growth-sys.pages.dev/schemas/recorder.schema.json",
  "title": "money-growth 月度快照录入模型（金额一律为「分」整数）",
  "type": "object",
  "required": ["month", "treeConfigId", "catConfigId", "assets", "debts"],
  "additionalProperties": false,
  "properties": {
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
      "description": "目标月份 YYYY-MM"
    },
    "treeConfigId": { "type": "integer", "minimum": 1 },
    "catConfigId": { "type": "integer", "minimum": 1 },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nodeId", "balanceCents", "hasNewFunds", "updateSource"],
        "additionalProperties": false,
        "properties": {
          "nodeId": { "type": "integer", "minimum": 1 },
          "balanceCents": { "type": "integer", "minimum": 0, "description": "余额（分），外币条目必须先经 mg_lookup_rate 换算为人民币分" },
          "hasNewFunds": { "type": "boolean" },
          "updateSource": { "enum": ["current", "carried"] }
        }
      }
    },
    "moduleGains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nodeId", "gainCents"],
        "additionalProperties": false,
        "properties": {
          "nodeId": { "type": "integer", "minimum": 1, "description": "必须是 hasNewFunds=true 的叶子节点" },
          "gainCents": { "type": ["integer", "null"], "description": "收益（分），允许负数；null 表示未提供" }
        }
      }
    },
    "income": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["catItemId", "amountCents"],
        "additionalProperties": false,
        "properties": {
          "catItemId": { "type": "integer", "minimum": 1, "description": "二级（叶子）收入分类" },
          "amountCents": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "expense": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["catItemId", "amountCents"],
        "additionalProperties": false,
        "properties": {
          "catItemId": { "type": "integer", "minimum": 1, "description": "二级（叶子）支出分类" },
          "amountCents": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "largeItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["direction", "catItemId", "name", "amountCents"],
        "additionalProperties": false,
        "properties": {
          "direction": { "enum": ["income", "expense"] },
          "catItemId": { "type": "integer", "minimum": 1, "description": "方向必须与 direction 一致的二级分类" },
          "name": { "type": "string", "minLength": 1, "maxLength": 50 },
          "amountCents": { "type": "integer", "minimum": 1, "description": "单笔大额（分），需 ≥ 站点阈值" }
        }
      }
    },
    "debts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["debtId", "balanceCents", "repaymentCents"],
        "additionalProperties": false,
        "properties": {
          "debtId": { "type": "integer", "minimum": 1 },
          "balanceCents": { "type": "integer", "minimum": 0 },
          "repaymentCents": { "type": "integer", "minimum": 0, "description": "固定还款负债由服务端覆盖为定额，此处仍必填占位" }
        }
      }
    },
    "pending": {
      "type": "array",
      "description": "低置信/缺失字段待确认清单（不入库）",
      "items": {
        "type": "object",
        "required": ["field", "reason"],
        "additionalProperties": false,
        "properties": {
          "field": { "type": "string" },
          "reason": { "type": "string" },
          "screenshotRegion": { "type": "string" }
        }
      }
    }
  }
}
