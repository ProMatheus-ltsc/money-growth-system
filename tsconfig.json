{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@shared/core": ["./vendor/shared-core/src/index.ts"],
      "@shared/core/*": ["./vendor/shared-core/src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vendor/shared-core/src"],
  "exclude": [
    "node_modules",
    "dist",
    "vendor/shared-core/src/components/visualize/CausalGraph.tsx",
    "vendor/shared-core/src/components/stats/RootCauseTypePie.tsx",
    "vendor/shared-core/src/hooks/useSearch.ts"
  ]
}
